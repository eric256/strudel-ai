# --- HTTPS reverse proxy (Caddy) ---------------------------------------------
# Names / IPs you will type into the browser, comma-separated.
# Include this machine's LAN IP so other devices can connect, e.g.:
SITE_ADDRESS=localhost, 192.168.1.50
# Certificate used when a browser connects by bare IP (browsers send no hostname then).
# Set it to the IP you use most:
DEFAULT_SNI=192.168.1.50
# "internal" = Caddy's own local CA (LAN use; trust it once per device, see README)
# an e-mail address = real Let's Encrypt cert (needs a public DNS name in SITE_ADDRESS
#                     and ports 80/443 reachable from the internet)
TLS_ISSUER=internal
# Host ports (change if 80/443 are taken, e.g. 8080 / 8443)
HTTP_PUBLIC_PORT=80
HTTPS_PUBLIC_PORT=443

# Which provider the UI selects first: llamacpp | openwebui | anthropic
DEFAULT_PROVIDER=llamacpp

# --- Claude (Anthropic API) ----------------------------------------------------
# API key from https://console.anthropic.com → API Keys. Stays on the server.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5   # default model (claude-opus-5-5 for the most capable)
ANTHROPIC_EFFORT=low                # low | medium | high — default thinking effort (changeable in ⚙ Settings → AI)
# ANTHROPIC_MAX_TOKENS=32000        # per reply, thinking included

# --- llama.cpp server (llama-server) -------------------------------------
# Run e.g.:  llama-server -m model.gguf --host 0.0.0.0 --port 8080 -c 8192
LLAMACPP_URL=http://host.docker.internal:8080
LLAMACPP_API_KEY=            # only if you started llama-server with --api-key
LLAMACPP_MODEL=              # usually blank; llama-server serves one model

# --- OpenWebUI ---------------------------------------------------------------
# API key: OpenWebUI > Settings > Account > API Keys
OPENWEBUI_URL=http://host.docker.internal:3000
OPENWEBUI_API_KEY=
OPENWEBUI_MODEL=             # e.g. qwen2.5-coder:14b  (pick from the dropdown in the UI)

# --- Generation ------------------------------------------------------------
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_MS=180000

# Optional: custom system prompt file inside the container
# SYSTEM_PROMPT_FILE=/app/my-prompt.md
